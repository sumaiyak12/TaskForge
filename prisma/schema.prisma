// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  clerkId           String   @unique
  email             String   @unique
  name              String
  avatar            String?
  role              String   @default("FREELANCER") // COMPANY | FREELANCER | ADMIN
  bio               String?
  githubUrl         String?
  portfolioUrl      String?
  resumeText        String?
  skills            String   @default("[]") // JSON string array of skills
  stripeAccountId   String?
  stripeConnected   Boolean  @default(false)
  subscriptionTier  String   @default("FREE") // FREE | PRO
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  projects          Project[]     @relation("CompanyProjects")
  tasksAssigned     MicroTask[]   @relation("AssignedTasks")
  applications      Application[]
  submissions       Submission[]
  payouts           Payout[]
  disputesRaised    Dispute[]     @relation("RaisedDisputes")
  notifications     Notification[]
  reviewsGiven      Review[]
}

model Project {
  id                    String   @id @default(uuid())
  companyId             String
  title                 String
  description           String
  totalBudget           Float
  currency              String   @default("INR")
  deadline              DateTime
  status                String   @default("DRAFT") // DRAFT | FUNDED | IN_PROGRESS | COMPLETED | CANCELLED
  stripePaymentIntentId String?
  stripeCheckoutSession String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relationships
  company               User        @relation("CompanyProjects", fields: [companyId], references: [id], onDelete: Cascade)
  tasks                 MicroTask[]
  payments              Payment[]
}

model MicroTask {
  id             String   @id @default(uuid())
  projectId      String
  title          String
  description    String
  budget         Float
  currency       String   @default("INR")
  deadline       DateTime
  skillsRequired String   @default("[]") // JSON string array
  status         String   @default("OPEN") // OPEN | ASSIGNED | IN_REVIEW | COMPLETED | DISPUTED
  assignedToId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo     User?         @relation("AssignedTasks", fields: [assignedToId], references: [id])
  applications   Application[]
  submissions    Submission[]
  payouts        Payout[]
  disputes       Dispute[]
  reviews        Review[]
}

model Application {
  id             String   @id @default(uuid())
  taskId         String
  freelancerId   String
  pitch          String
  estimatedHours Int      @default(5)
  status         String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt      DateTime @default(now())

  // Relationships
  task           MicroTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  freelancer     User      @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Submission {
  id             String   @id @default(uuid())
  taskId         String
  freelancerId   String
  deliverableUrl String
  repoUrl        String?
  notes          String?
  qualityScore   Int      @default(0) // 0 - 100
  qualityReport  String?  // JSON string breakdown
  fraudScore     Int      @default(0) // 0 - 100 risk
  fraudReport    String?  // JSON string report
  status         String   @default("SUBMITTED") // SUBMITTED | AI_VERIFIED | APPROVED | REJECTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  task           MicroTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  freelancer     User      @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(uuid())
  taskId      String
  reviewerId  String
  rating      Int      @default(5)
  comment     String?
  createdAt   DateTime @default(now())

  // Relationships
  task        MicroTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer    User      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String   @id @default(uuid())
  projectId             String
  amount                Float
  currency              String   @default("INR")
  status                String   @default("PENDING") // PENDING | SUCCEEDED | FAILED
  stripeSessionId       String?
  stripePaymentIntentId String?
  createdAt             DateTime @default(now())

  // Relationships
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Payout {
  id               String   @id @default(uuid())
  taskId           String
  freelancerId     String
  amount           Float
  currency         String   @default("INR")
  status           String   @default("PENDING") // PENDING | PAID | FAILED
  stripeTransferId String?
  createdAt        DateTime @default(now())

  // Relationships
  task             MicroTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  freelancer       User      @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
}

model Dispute {
  id          String    @id @default(uuid())
  taskId      String
  raisedById  String
  reason      String
  status      String    @default("OPEN") // OPEN | RESOLVED_REFUND | RESOLVED_PAYOUT
  adminNotes  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  // Relationships
  task        MicroTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  raisedBy    User      @relation("RaisedDisputes", fields: [raisedById], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | ACTION
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relationships
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
